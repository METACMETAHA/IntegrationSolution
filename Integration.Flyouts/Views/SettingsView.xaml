<UserControl x:Class="Integration.Flyouts.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Integration.Flyouts.ViewModels"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:Partial="clr-namespace:Integration.PartialViews.Views;assembly=Integration.PartialViews"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks.Converter;assembly=MahApps.Metro.IconPacks.FontAwesome"
             xmlns:loc="clr-namespace:IntegrationSolution.Localization.Markup;assembly=IntegrationSolution.Localization"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" MinWidth="500" Width="700" Padding="10 0">
    <Grid>

        <Controls:MetroAnimatedTabControl>
            <Controls:MetroTabItem Header="{loc:Loc Settings_GeneralTab}">
                <StackPanel Margin="30 20" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Margin="0 0 0 6"
                               FontSize="14"
                               Text="{loc:Loc Settings_LanguageLabel}" />
                    <ComboBox MinWidth="220"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="LanguageSelector"
                              AutomationProperties.Name="{loc:Loc Settings_LanguageLabel}"
                              DisplayMemberPath="NativeName"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    <TextBlock Margin="0 8 0 0"
                               FontSize="12"
                               Opacity="0.7"
                               Text="{loc:Loc Settings_LanguageHint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="Wialon">
                <Partial:GetTokenView Padding="30 10"/>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="{loc:Loc Settings_ExcelHeadersTab}">
                <Partial:ChangeHeadersView Padding="30 10 0 0"/>
            </Controls:MetroTabItem>
        </Controls:MetroAnimatedTabControl>

    </Grid>
</UserControl>
