<Dialogs:BaseMetroDialog x:Class="FleetAudit.Dialogs.Views.DatesFromToDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:Dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"  
             xmlns:PartialViews="clr-namespace:FleetAudit.Dialogs.PartialViews"
             xmlns:local="clr-namespace:FleetAudit.Dialogs.Views"
             xmlns:loc="clr-namespace:FleetAudit.Localization.Markup;assembly=FleetAudit.Localization"
             mc:Ignorable="d" Title="{loc:Loc Dialogs_DatesTitle}">

    <StackPanel>
        <PartialViews:DatesFromToPartialView/>

        <CheckBox IsChecked="{Binding Dates.IsWithDetails}" Content="{loc:Loc Dialogs_DetailedReport}" Margin="10"
                  FontStyle="Italic" FontStretch="SemiExpanded" HorizontalAlignment="Left"/>

        <PartialViews:OkCancelPartialView/>
    </StackPanel>
    
</Dialogs:BaseMetroDialog>
