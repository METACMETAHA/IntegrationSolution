<UserControl x:Class="FleetAudit.Dialogs.PartialViews.OkPartialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FleetAudit.Dialogs.PartialViews"
             xmlns:loc="clr-namespace:FleetAudit.Localization.Markup;assembly=FleetAudit.Localization"
             xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls">

    <StackPanel
      Orientation="Horizontal" HorizontalAlignment="Right"
      Margin="10">
        <Button Command="{Binding OkCommand}" Content="{loc:Loc Common_Ok}" IsDefault="True"
                        HorizontalAlignment="Right"
                        Width="100" Margin="10" Style="{DynamicResource AccentedSquareButtonStyle}"/>
    </StackPanel>

</UserControl>
